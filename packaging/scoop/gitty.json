{
  "version": "VERSION",
  "description": "Friendly git client for the terminal",
  "homepage": "https://github.com/lettdev/gitty",
  "license": "LICENSE",
  "depends": "git",
  "architecture": {
    "64bit": {
      "url": "https://github.com/lettdev/gitty/releases/download/vVERSION/gitty-vVERSION-windows-x64.zip",
      "hash": "SHA256_WINDOWS_X64",
      "extract_dir": "gitty-vVERSION-windows-x64"
    }
  },
  "bin": "gitty.exe",
  "checkver": "github",
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://github.com/lettdev/gitty/releases/download/v$version/gitty-v$version-windows-x64.zip",
        "extract_dir": "gitty-v$version-windows-x64",
        "hash": { "url": "$url.sha256" }
      }
    }
  }
}
